DATA_FABRIC_HOST=0.0.0.0
DATA_FABRIC_PORT=8404
DATA_FABRIC_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATA_FABRIC_QUERY_TIMEOUT_SECONDS=30
# Electron 로컬 환경에서 요청별 Neo4j header override를 쓸 때만 true
DATA_FABRIC_ALLOW_NEO4J_HEADER_OVERRIDE=false
# 원천 접속값의 `localhost` 를 무엇으로 바꿀지. 코드가 읽는 이름은 이것이다
# (shared/config/settings.py). 2026-10-29 까지 `MINDSDB_REPLACE_LOCALHOST` 로
# 적혀 있었는데 **아무도 읽지 않는 이름**이었다 — 기본값이 같아서 조용했다.
ROBO_DATASOURCE_REPLACE_LOCALHOST=host.docker.internal
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j
